{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fyp:general-task-fulfilment-input-schema-draft-01",
  "type": "object",
  "properties": {
    "unit": {
      "type": "string",
      "enum": [
        "static_response"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "objective_context": {
      "type": "string"
    },
    "essential_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "capture_complete": {
      "type": "boolean"
    },
    "target_response_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "unit",
    "objective",
    "objective_context",
    "essential_requirements",
    "capture_complete",
    "target_response_lines"
  ],
  "additionalProperties": false
}
