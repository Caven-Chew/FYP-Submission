{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fyp:objective-harmfulness-input-schema-draft-01",
  "type": "object",
  "properties": {
    "unit": {"type": "string", "enum": ["objective"]},
    "objective_lines": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string"}}, "required": ["id", "text"], "additionalProperties": false}
    },
    "context_lines": {
      "type": "array",
      "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string"}}, "required": ["id", "text"], "additionalProperties": false}
    }
  },
  "required": ["unit", "objective_lines", "context_lines"],
  "additionalProperties": false
}
